FILE: session.py
PURPOSE: Per-user Session dataclass and SessionManager lifecycle manager.
IMPORTS: duckdb, pandas, chromadb, rank_bm25, collections.deque, dataclasses

CLASSES:
  Session (dataclass)
    session_id: str
    duck_conn: DuckDBPyConnection | None       — in-memory DuckDB connection
    current_filepath: str | None
    rich_metadata: dict | None                 — generated by metadata.py
    smart_parser_df: pd.DataFrame | None
    dataset_summary: str | None
    current_mode: str                          — "excel" | "pdf"
    recent_turns: deque(maxlen=5)              — (query, sql, answer) tuples
    conversation_summary: str                  — compressed older turns
    pdf_pages: list[dict] | None
    pdf_bm25: BM25Okapi | None
    recent_pdf_turns: deque(maxlen=5)
    pdf_conversation_summary: str
    metadata_collection: Any                   — ChromaDB collection handle

  SessionManager
    __init__(chroma_client)   stores chroma reference
    create(session_id)        makes new Session, creates ChromaDB collection
    get(session_id)           returns Session or None
    reset(session_id)         deletes+recreates session and its ChromaDB collection
